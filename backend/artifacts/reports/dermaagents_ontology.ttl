da:treatment_Acne_0
    a da:Treatment ;
    rdfs:label "Skin-care advice and self-care" ;
    da:responseProbability 3e-01 ;
    da:weeks 6 ;
.

da:treatment_Acne_1
    a da:Treatment ;
    rdfs:label "Clinician-led topical treatment (topical class)" ;
    da:responseProbability 5e-01 ;
    da:weeks 12 ;
.

da:treatment_Acne_2
    a da:Treatment ;
    rdfs:label "Combined topical + oral therapy class" ;
    da:responseProbability 5.5e-01 ;
    da:weeks 12 ;
.

da:treatment_Acne_3
    a da:Treatment ;
    rdfs:label "Specialist dermatology referral" ;
    da:responseProbability 7e-01 ;
    da:weeks 16 ;
.

da:treatment_Basal_Cell_Carcinoma_0
    a da:Treatment ;
    rdfs:label "Dermatology assessment and biopsy" ;
    da:responseProbability 0e+00 ;
    da:weeks 4 ;
.

da:treatment_Basal_Cell_Carcinoma_1
    a da:Treatment ;
    rdfs:label "Surgical removal" ;
    da:responseProbability 9e-01 ;
    da:weeks 4 ;
.

da:treatment_Basal_Cell_Carcinoma_2
    a da:Treatment ;
    rdfs:label "Non-surgical options (e.g. photodynamic therapy, radiotherapy)" ;
    da:responseProbability 7.5e-01 ;
    da:weeks 8 ;
.

da:treatment_Eczema_0
    a da:Treatment ;
    rdfs:label "Daily emollients and trigger avoidance" ;
    da:responseProbability 3.5e-01 ;
    da:weeks 4 ;
.

da:treatment_Eczema_1
    a da:Treatment ;
    rdfs:label "Stepped topical anti-inflammatory treatment (topical class)" ;
    da:responseProbability 5.5e-01 ;
    da:weeks 4 ;
.

da:treatment_Eczema_2
    a da:Treatment ;
    rdfs:label "Specialist referral (e.g. phototherapy / systemic class)" ;
    da:responseProbability 6.5e-01 ;
    da:weeks 12 ;
.

da:treatment_Melanoma_0
    a da:Treatment ;
    rdfs:label "Urgent specialist assessment and biopsy" ;
    da:responseProbability 0e+00 ;
    da:weeks 2 ;
.

da:treatment_Melanoma_1
    a da:Treatment ;
