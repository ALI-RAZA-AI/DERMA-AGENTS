PREFIX da: <https://dermaagents.example.org/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://dermaagents.example.org/ontology>
    a owl:Ontology ;
    rdfs:comment "DermaAgents academic ontology - not clinically validated." ;
.

da:citedBy
    a owl:ObjectProperty ;
    rdfs:domain da:Disease ;
    rdfs:range da:Source ;
.

da:diagnosedWith
    a owl:ObjectProperty ;
    rdfs:domain da:Patient ;
    rdfs:range da:Disease ;
.

da:differentialOf
    a
        owl:ObjectProperty ,
        owl:SymmetricProperty ;
    rdfs:domain da:Disease ;
    rdfs:range da:Disease ;
.

da:hasFollowUp
    a owl:ObjectProperty ;
    rdfs:domain da:Disease ;
    rdfs:range da:FollowUp ;
.

da:hasSeverity
    a owl:ObjectProperty ;
    rdfs:domain da:Disease ;
    rdfs:range da:Severity ;
.

da:hasSymptom
    a owl:ObjectProperty ;
    rdfs:domain da:Patient ;
    rdfs:range da:Symptom ;
.

da:indicatesDisease
    a owl:ObjectProperty ;
    rdfs:domain da:Symptom ;
    rdfs:range da:Disease ;
.

da:requiresReassessment
    a owl:ObjectProperty ;
    rdfs:domain da:Disease ;
    rdfs:range da:ReassessmentTrigger ;
.

da:responseProbability
    a owl:DatatypeProperty ;
.

da:source_christie_melanoma
    a da:Source ;
    rdfs:label "Melanoma - The Christie NHS FT" ;
    da:url "https://christie.nhs.uk/understanding-cancer/types-of-cancer/melanoma"^^xsd:anyURI ;
.

da:source_gosh_acne
    a da:Source ;
    rdfs:label "Acne - Great Ormond Street Hospital" ;
    da:url "https://gosh.nhs.uk/conditions-and-treatments/general-medical-conditions/acne"^^xsd:anyURI ;
.

da:source_hwt_eczema
    a da:Source ;
    rdfs:label "Eczema - Healthier Together (NHS)" ;
    da:url "https://healthiertogether.westlondon.nhs.uk/wessex-updated-content-jan-2022/eczema"^^xsd:anyURI ;
.

da:source_nhs_eczema
    a da:Source ;
    rdfs:label "Atopic eczema - NHS" ;
    da:url "https://www.nhs.uk/conditions/atopic-eczema/"^^xsd:anyURI ;
.

da:source_nhs_eczema_tx
    a da:Source ;
    rdfs:label "Atopic eczema - Treatment - NHS" ;
    da:url "https://www.nhs.uk/conditions/atopic-eczema/treatment"^^xsd:anyURI ;
.

da:source_nice_ng198
    a da:Source ;
    rdfs:label "Acne vulgaris: management (NG198) - final scope" ;
    da:url "https://nice.org.uk/guidance/ng198/documents/final-scope"^^xsd:anyURI ;
.

da:source_pubmed_sk
    a da:Source ;
    rdfs:label "Seborrheic keratosis (review), J Dtsch Dermatol Ges 2023;21(3):265-277" ;
    da:url "https://pubmed.ncbi.nlm.nih.gov/36892019/"^^xsd:anyURI ;
.

da:source_swbh_bcc
    a da:Source ;
    rdfs:label "Basal Cell Carcinoma (BCC) - information for patients" ;
    da:url "https://www.swbh.nhs.uk/wp-content/uploads/2023/12/Basal-Cell-Carcinoma-BCC-ML6281.pdf"^^xsd:anyURI ;
.

da:source_tschandl_ham
    a da:Source ;
    rdfs:label "Tschandl et al. 2018, The HAM10000 dataset (Scientific Data 5:180161)" ;
    da:url "https://doi.org/10.1038/sdata.2018.161"^^xsd:anyURI ;
.

da:source_wales_psoriasis
    a da:Source ;
    rdfs:label "Psoriasis - NHS 111 Wales" ;
    da:url "https://111.wales.nhs.uk/encyclopaedia/p/article/psoriasis/"^^xsd:anyURI ;
.

da:symptom_asymmetry
    a da:Symptom ;
    rdfs:label "Asymmetrical lesion" ;
    rdfs:comment "Two halves differ in shape." ;
    da:indicatesDisease da:disease_Melanoma ;
.

da:symptom_atopic_history
    a da:Symptom ;
    rdfs:label "Personal/family history of asthma or hay fever" ;
    rdfs:comment "Atopic background." ;
    da:indicatesDisease da:disease_Eczema ;
.

da:symptom_bleeding_lesion
    a da:Symptom ;
    rdfs:label "Bleeding or itchy lesion" ;
    rdfs:comment "Lesion that bleeds, crusts or itches." ;
    da:indicatesDisease
        da:disease_Basal_Cell_Carcinoma ,
        da:disease_Melanoma ,
        da:disease_Skin_Cancer__unspecified ;
.

da:symptom_brown_black_lesion
    a da:Symptom ;
    rdfs:label "Brown or black lesion" ;
    rdfs:comment "Pigmented lesion." ;
    da:indicatesDisease
        da:disease_Melanoma ,
        da:disease_Seborrheic_Keratosis ,
        da:disease_Skin_Cancer__unspecified ;
.

da:symptom_comedones
    a da:Symptom ;
    rdfs:label "Blackheads or whiteheads" ;
    rdfs:comment "Open or closed comedones." ;
    da:indicatesDisease da:disease_Acne ;
.

da:symptom_cracked_skin
    a da:Symptom ;
    rdfs:label "Cracked or sore skin" ;
    rdfs:comment "Fissured, sore skin." ;
    da:indicatesDisease da:disease_Eczema ;
.

da:symptom_dry_skin
    a da:Symptom ;
    rdfs:label "Dry skin" ;
    rdfs:comment "Rough, dry skin." ;
    da:indicatesDisease
        da:disease_Eczema ,
        da:disease_Psoriasis ;
.

da:symptom_face_chest_back
    a da:Symptom ;
    rdfs:label "Lesions on face, chest or back" ;
    rdfs:comment "Typical acne distribution." ;
    da:indicatesDisease da:disease_Acne ;
.

da:symptom_flare_pattern
    a da:Symptom ;
    rdfs:label "Flare-ups and remissions" ;
    rdfs:comment "Symptoms come and go over time." ;
    da:indicatesDisease
        da:disease_Eczema ,
        da:disease_Psoriasis ;
.

da:symptom_inflamed_spots
    a da:Symptom ;
    rdfs:label "Red inflamed spots / pustules" ;
    rdfs:comment "Papules or pus-filled spots." ;
    da:indicatesDisease da:disease_Acne ;
.

da:symptom_irregular_border
    a da:Symptom ;
    rdfs:label "Irregular border" ;
    rdfs:comment "Ragged, notched or blurred edge." ;
    da:indicatesDisease da:disease_Melanoma ;
.

da:symptom_itch
    a da:Symptom ;
    rdfs:label "Itching" ;
    rdfs:comment "Pruritus of the affected skin." ;
    da:indicatesDisease
        da:disease_Eczema ,
        da:disease_Psoriasis ,
        da:disease_Seborrheic_Keratosis ;
.

da:symptom_joint_pain
    a da:Symptom ;
    rdfs:label "Joint pain or stiffness" ;
    rdfs:comment "Possible psoriatic arthritis." ;
    da:indicatesDisease da:disease_Psoriasis ;
.

da:symptom_large_diameter
    a da:Symptom ;
    rdfs:label "Lesion wider than about 6 mm" ;
    rdfs:comment "Larger than typical benign moles." ;
    da:indicatesDisease da:disease_Melanoma ;
.

da:symptom_multiple_colours
    a da:Symptom ;
    rdfs:label "Several colours in one lesion" ;
    rdfs:comment "Uneven colour, mixed shades." ;
    da:indicatesDisease da:disease_Melanoma ;
.

da:symptom_multiple_lesions
    a da:Symptom ;
    rdfs:label "Multiple similar lesions" ;
    rdfs:comment "Many lesions of the same type." ;
    da:indicatesDisease da:disease_Seborrheic_Keratosis ;
.

da:symptom_nail_changes
    a da:Symptom ;
    rdfs:label "Nail changes" ;
    rdfs:comment "Pitting or thickening of nails." ;
    da:indicatesDisease da:disease_Psoriasis ;
.

da:symptom_new_or_changing_mole
    a da:Symptom ;
    rdfs:label "New or changing mole" ;
    rdfs:comment "A new mole or a change in an existing one." ;
    da:indicatesDisease
        da:disease_Melanoma ,
        da:disease_Skin_Cancer__unspecified ;
.

da:symptom_nodules_cysts
    a da:Symptom ;
    rdfs:label "Painful deep lumps (nodules/cysts)" ;
    rdfs:comment "Deep, painful lesions under the skin." ;
    da:indicatesDisease da:disease_Acne ;
.

da:symptom_non_healing_sore
    a da:Symptom ;
    rdfs:label "Sore that does not heal" ;
    rdfs:comment "Ulcer or scab persisting for weeks." ;
    da:indicatesDisease
        da:disease_Basal_Cell_Carcinoma ,
        da:disease_Skin_Cancer__unspecified ;
.

da:symptom_oily_skin
    a da:Symptom ;
    rdfs:label "Oily / greasy skin" ;
    rdfs:comment "Excess sebum on the face or trunk." ;
    da:indicatesDisease da:disease_Acne ;
.

da:symptom_older_age
    a da:Symptom ;
    rdfs:label "Older adult (typically 50+)" ;
    rdfs:comment "Age-related onset." ;
    da:indicatesDisease da:disease_Seborrheic_Keratosis ;
.

da:symptom_pearly_bump
    a da:Symptom ;
    rdfs:label "Shiny / pearly bump" ;
    rdfs:comment "Small pink, red or pearly bump." ;
    da:indicatesDisease
        da:disease_Basal_Cell_Carcinoma ,
        da:disease_Skin_Cancer__unspecified ;
.

da:symptom_plaques_extensor
    a da:Symptom ;
    rdfs:label "Plaques on elbows, knees, scalp or lower back" ;
    rdfs:comment "Typical plaque psoriasis sites." ;
    da:indicatesDisease da:disease_Psoriasis ;
.

da:symptom_red_patches
    a da:Symptom ;
    rdfs:label "Red / inflamed patches" ;
    rdfs:comment "Areas of inflamed skin." ;
    da:indicatesDisease
        da:disease_Eczema ,
        da:disease_Psoriasis ;
.

da:symptom_scarring
    a da:Symptom ;
    rdfs:label "Scarring" ;
    rdfs:comment "Marks or pits left after lesions heal." ;
    da:indicatesDisease da:disease_Acne ;
.

da:symptom_silvery_scales
    a da:Symptom ;
    rdfs:label "Silvery-white scales" ;
    rdfs:comment "Scaly plaques with silvery-white scale." ;
    da:indicatesDisease da:disease_Psoriasis ;
.

da:symptom_skin_creases
    a da:Symptom ;
    rdfs:label "Lesions in skin creases" ;
    rdfs:comment "Elbow folds, behind knees, neck." ;
    da:indicatesDisease da:disease_Eczema ;
.

da:symptom_slow_growth
    a da:Symptom ;
    rdfs:label "Slowly growing lesion" ;
    rdfs:comment "Gradual enlargement over months." ;
    da:indicatesDisease
        da:disease_Basal_Cell_Carcinoma ,
        da:disease_Skin_Cancer__unspecified ;
.

da:symptom_stuck_on
    a da:Symptom ;
    rdfs:label "'Stuck-on' waxy lesion" ;
    rdfs:comment "Looks pasted onto the skin surface." ;
    da:indicatesDisease da:disease_Seborrheic_Keratosis ;
.

da:symptom_sun_exposed_site
    a da:Symptom ;
    rdfs:label "On a sun-exposed site (face, ears, neck)" ;
    rdfs:comment "Chronically sun-exposed skin." ;
    da:indicatesDisease da:disease_Basal_Cell_Carcinoma ;
.

da:symptom_warty_surface
    a da:Symptom ;
    rdfs:label "Rough, warty surface" ;
    rdfs:comment "Scaly or warty texture." ;
    da:indicatesDisease da:disease_Seborrheic_Keratosis ;
.

da:symptom_weeping_crusting
    a da:Symptom ;
    rdfs:label "Weeping or crusted skin" ;
    rdfs:comment "Oozing or crusting (possible infection)." ;
    da:indicatesDisease da:disease_Eczema ;
.

da:treatedBy
    a owl:ObjectProperty ;
    rdfs:domain da:Disease ;
    rdfs:range da:Treatment ;
.

da:url
    a owl:DatatypeProperty ;
.

da:weeks
    a owl:DatatypeProperty ;
.

da:weight
    a owl:DatatypeProperty ;
.

da:followup_Acne
    a da:FollowUp ;
    rdfs:label "Simulated review after 12 weeks" ;
    da:weeks 12 ;
.

da:followup_Basal_Cell_Carcinoma
    a da:FollowUp ;
    rdfs:label "Simulated review after 12 weeks" ;
    da:weeks 12 ;
.

da:followup_Eczema
    a da:FollowUp ;
    rdfs:label "Simulated review after 4 weeks" ;
    da:weeks 4 ;
.

da:followup_Melanoma
    a da:FollowUp ;
    rdfs:label "Simulated review after 12 weeks" ;
    da:weeks 12 ;
.

da:followup_Psoriasis
    a da:FollowUp ;
    rdfs:label "Simulated review after 8 weeks" ;
    da:weeks 8 ;
.

da:followup_Seborrheic_Keratosis
    a da:FollowUp ;
    rdfs:label "Simulated review after 26 weeks" ;
    da:weeks 26 ;
.

da:followup_Skin_Cancer__unspecified
    a da:FollowUp ;
    rdfs:label "Simulated review after 12 weeks" ;
    da:weeks 12 ;
.

da:reassess_Acne_0
    a da:ReassessmentTrigger ;
    rdfs:label "Nodules/cysts or scarring despite treatment -> specialist referral" ;
.

da:reassess_Basal_Cell_Carcinoma_0
    a da:ReassessmentTrigger ;
    rdfs:label "Lesion not healing after ~4 weeks -> clinical assessment / biopsy" ;
.

da:reassess_Eczema_0
    a da:ReassessmentTrigger ;
    rdfs:label "Weeping, crusting or rapidly worsening painful eczema (possible infection) -> urgent review" ;
.

da:reassess_Melanoma_0
    a da:ReassessmentTrigger ;
    rdfs:label "New or changing mole with ABCDE features -> urgent specialist assessment" ;
.

da:reassess_Psoriasis_0
    a da:ReassessmentTrigger ;
    rdfs:label "Widespread pustules or skin-wide redness -> emergency care" ;
.

da:reassess_Psoriasis_1
    a da:ReassessmentTrigger ;
    rdfs:label "Recurring joint pain/swelling -> review for psoriatic arthritis" ;
.

da:reassess_Seborrheic_Keratosis_0
    a da:ReassessmentTrigger ;
    rdfs:label "Doubtful or very dark lesion -> biopsy to exclude melanoma" ;
.

da:reassess_Skin_Cancer__unspecified_0
    a da:ReassessmentTrigger ;
    rdfs:label "Any suspected malignancy -> dermatology referral and biopsy" ;
.

da:severity_Acne_mild
    a da:Severity ;
    rdfs:label "Acne: mild" ;
    rdfs:comment "A few spots, blackheads/whiteheads" ;
.

da:severity_Acne_moderate
    a da:Severity ;
    rdfs:label "Acne: moderate" ;
    rdfs:comment "Widespread inflamed spots" ;
.

da:severity_Acne_severe
    a da:Severity ;
    rdfs:label "Acne: severe" ;
    rdfs:comment "Painful nodules or cysts; scarring risk" ;
.

da:severity_Basal_Cell_Carcinoma_mild
    a da:Severity ;
    rdfs:label "Basal Cell Carcinoma: mild" ;
    rdfs:comment "Small, slow-growing lesion" ;
.

da:severity_Basal_Cell_Carcinoma_moderate
    a da:Severity ;
    rdfs:label "Basal Cell Carcinoma: moderate" ;
    rdfs:comment "Larger lesion" ;
.

da:severity_Basal_Cell_Carcinoma_severe
    a da:Severity ;
    rdfs:label "Basal Cell Carcinoma: severe" ;
    rdfs:comment "Large or long-untreated lesion (more complex treatment)" ;
.

da:severity_Eczema_mild
    a da:Severity ;
    rdfs:label "Eczema: mild" ;
    rdfs:comment "Small areas of dry, itchy skin" ;
.

da:severity_Eczema_moderate
    a da:Severity ;
    rdfs:label "Eczema: moderate" ;
    rdfs:comment "Red, itchy, widespread patches" ;
.

da:severity_Eczema_severe
    a da:Severity ;
    rdfs:label "Eczema: severe" ;
    rdfs:comment "Extensive, cracked or weeping skin; possible infection" ;
.

da:severity_Melanoma_mild
    a da:Severity ;
    rdfs:label "Melanoma: mild" ;
    rdfs:comment "-" ;
.

da:severity_Melanoma_moderate
    a da:Severity ;
    rdfs:label "Melanoma: moderate" ;
    rdfs:comment "-" ;
.

da:severity_Melanoma_severe
    a da:Severity ;
    rdfs:label "Melanoma: severe" ;
    rdfs:comment "Any suspicion warrants urgent specialist assessment" ;
.

da:severity_Psoriasis_mild
    a da:Severity ;
    rdfs:label "Psoriasis: mild" ;
    rdfs:comment "Few small plaques" ;
.

da:severity_Psoriasis_moderate
    a da:Severity ;
    rdfs:label "Psoriasis: moderate" ;
    rdfs:comment "Larger areas affected" ;
.

da:severity_Psoriasis_severe
    a da:Severity ;
    rdfs:label "Psoriasis: severe" ;
    rdfs:comment "Widespread / pustular / erythrodermic forms needing urgent care" ;
.

da:severity_Seborrheic_Keratosis_mild
    a da:Severity ;
    rdfs:label "Seborrheic Keratosis: mild" ;
    rdfs:comment "Asymptomatic" ;
.

da:severity_Seborrheic_Keratosis_moderate
    a da:Severity ;
    rdfs:label "Seborrheic Keratosis: moderate" ;
    rdfs:comment "Irritated / itchy lesion" ;
.

da:severity_Seborrheic_Keratosis_severe
    a da:Severity ;
    rdfs:label "Seborrheic Keratosis: severe" ;
    rdfs:comment "Atypical appearance needing exclusion of cancer" ;
.

da:severity_Skin_Cancer__unspecified_mild
    a da:Severity ;
    rdfs:label "Skin Cancer (unspecified): mild" ;
    rdfs:comment "-" ;
.

da:severity_Skin_Cancer__unspecified_moderate
    a da:Severity ;
    rdfs:label "Skin Cancer (unspecified): moderate" ;
    rdfs:comment "-" ;
.

da:severity_Skin_Cancer__unspecified_severe
    a da:Severity ;
    rdfs:label "Skin Cancer (unspecified): severe" ;
    rdfs:comment "Specialist assessment and biopsy" ;
.

